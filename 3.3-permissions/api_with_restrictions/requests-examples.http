# примеры API-запросов

@baseUrl = http://localhost:8000/api

# получение объявлений
GET {{baseUrl}}/advertisements/
Content-Type: application/json

###

# создание объявления
POST {{baseUrl}}/advertisements/
Content-Type: application/json
Authorization: Token b3e6e3c5ab3476586600d44328fbf7f5ebadd008

{
  "title": "Шкаф IKEA2czczxc",
  "description": "Срочнqd"
}

###

# попытка поменять объявление
PATCH {{baseUrl}}/advertisements/44/
Content-Type: application/json
Authorization: Token b3e6e3c5ab3476586600d44328fbf7f5ebadd008

{
  "status": "CLOSED"
}

###


# попытка удалить объявление
DELETE {{baseUrl}}/advertisements/53/
Content-Type: application/json
Authorization: Token b3e6e3c5ab3476586600d44328fbf7f5ebadd008



###

# фильтрация по создателю
GET {{baseUrl}}/advertisements/?creator=2
Content-Type: application/json

###

# фильтрация по дате
GET {{baseUrl}}/advertisements/?created_at_before=2025-10-01
Content-Type: application/json


###

# # получить токен
# POST {{baseUrl}}/advertisements/auth/token/login/
# Content-Type: application/json

# {
#   "username": "admin",
#   "password": "admin"

# }